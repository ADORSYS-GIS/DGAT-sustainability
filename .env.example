# ===== Core Infrastructure =====
# PostgreSQL
POSTGRES_DB=sustainability
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ===== Backend =====
RUST_LOG=info,hyper=info,sea_orm=info
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
CORS_ORIGIN=https://localhost
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}"

# Keycloak (backend)
KEYCLOAK_URL=https://localhost/keycloak
KEYCLOAK_REALM=sustainability-realm
KEYCLOAK_CLIENT_ID=sustainability-tool

# ===== Frontend (Vite build-time) =====
FE_HOST=localhost
API_BASE_URL=https://localhost
VITE_KEYCLOAK_URL=https://localhost/keycloak
VITE_KEYCLOAK_ISSUER_URI=https://localhost/keycloak/realms/sustainability-realm
VITE_KEYCLOAK_CLIENT_ID=sustainability-tool
VITE_KEYCLOAK_SCOPES=openid profile email
VITE_KEYCLOAK_HOME_URL=https://localhost
VITE_KEYCLOAK_REDIRECT_URI=https://localhost/callback
VITE_ORGANIZATION_REDIRECT_URL=https://localhost

# ===== SSL =====
# Used by scripts/generate_ssl.sh
# Replace with your public DNS name for production (e.g., app.example.com)
SERVER_DN=localhost
# Used by Nginx envsubst templating for server_name
SERVER_NAME=localhost

# ===== Keycloak (container) =====
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_FRONTEND_URL=https://localhost/keycloak
KEYCLOAK_SERVER=https://localhost
KC_HOSTNAME=localhost
KC_HOSTNAME_URL=https://localhost/keycloak
KC_URL=localhost

# Email (SMTP) for Keycloak notifications (set real values in production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=noreply@example.com
EMAIL_FROM_DISPLAY_NAME=Sustainability Tool
EMAIL_USER=you@example.com
EMAIL_PASSWORD=changeMe
EMAIL_SSL=false
EMAIL_STARTTLS=true
EMAIL_AUTH=true

# ===== Misc =====
# Password for example seeded user in Keycloak provisioning script (if used)
FERNANDO_PASSWORD=SecurePassword123!
